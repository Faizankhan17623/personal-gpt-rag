# Copy this file to .env and fill in your own values.
PORT=4000

# Pinecone: a dense, 1024-dimensional, cosine index.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# MongoDB connection string. Leave empty to keep chats in memory (local testing only).
MONGODB_URI=

# Frontend URL(s) allowed to call the API, comma-separated. Leave empty to allow any (local only).
CORS_ORIGIN=
