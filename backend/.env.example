# Copy this file to .env and fill in your own values. Never commit .env.
PORT=4000

# Pinecone (https://app.pinecone.io): a dense, cosine index with at least 384 dimensions
# (e.g. 1024, or 3000 with automatic zero-padding).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Groq (https://console.groq.com/keys). GROQ_MODEL is optional; defaults to openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Leave empty to keep chats in memory: fine for local testing, lost on restart.
MONGODB_URI=

# Frontend URL(s) allowed to call the API, comma-separated (e.g. https://your-app.vercel.app).
# Leave empty to allow any origin: local development only.
CORS_ORIGIN=
